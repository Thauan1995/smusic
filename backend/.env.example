# Copy to .env (or export these directly) for local development.
# See internal/platform/config/config.go for defaults and full docs.

HTTP_ADDR=:8080

DATABASE_URL=postgres://smusic:smusic@localhost:5432/smusic?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Dev-only: leave unset to auto-generate an ephemeral Ed25519 signing key
# at startup (tokens won't survive a restart). Generate a real one for
# anything persistent with:
#   openssl rand -hex 32
JWT_ED25519_SEED_HEX=
JWT_ISSUER=smusic
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Dev-only: leave unset to run without a password pepper. Generate a real
# one with: openssl rand -hex 32
PASSWORD_PEPPER_HEX=

MEDIA_BASE_URL=http://localhost:8080/media
MEDIA_SIGNING_KEY=dev-only-insecure-media-signing-key

LOGIN_RATE_LIMIT_PER_MINUTE=10

# ENV=production switches slog to JSON output; LOG_LEVEL=debug raises verbosity.
ENV=development
LOG_LEVEL=info
