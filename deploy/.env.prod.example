# Copy to deploy/.env.prod and fill in real values before deploying.
# NEVER commit deploy/.env.prod (it holds real secrets) — only this
# .example file is tracked in git.
#
# Same variables backend/.env.example documents (see
# internal/platform/config/config.go for the full list/defaults) — this
# file just pins production values for the VPS deploy.

# --- Domain (sslip.io magic DNS, no registration needed) ---
# Replace with your VPS's reserved public IP, dashes instead of dots, e.g.
# IP 152.67.12.34 -> SMUSIC_DOMAIN=152-67-12-34.sslip.io
SMUSIC_DOMAIN=xxx-xxx-xxx-xxx.sslip.io
SMUSIC_API_BASE_URL=https://xxx-xxx-xxx-xxx.sslip.io

# --- Postgres ---
POSTGRES_PASSWORD=troque-isto
DATABASE_URL=postgres://smusic:troque-isto@postgres:5432/smusic?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Secrets: generate real ones, do not leave blank in production ---
# openssl rand -hex 32
JWT_ED25519_SEED_HEX=
# openssl rand -hex 32
PASSWORD_PEPPER_HEX=
# openssl rand -hex 32 (signs the fake local media URLs, internal-only use)
MEDIA_SIGNING_KEY=

# --- CORS / media (must match SMUSIC_DOMAIN above, with https://) ---
CORS_ALLOWED_ORIGINS=https://xxx-xxx-xxx-xxx.sslip.io
MEDIA_BASE_URL=https://xxx-xxx-xxx-xxx.sslip.io/media

# --- Logging ---
ENV=production
LOG_LEVEL=info
